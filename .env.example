# Salin ke .env.local lalu isi dengan nilai dari Supabase (Project Settings → API).
# Untuk Supabase lokal, nilainya dicetak oleh `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-key

# Isi "true" untuk menampilkan dashboard anggaran dengan data demo fiktif (berlabel) selama data APBD resmi belum dikurasi.
VITE_DATA_DEMO_ANGGARAN=false

# JANGAN pernah menaruh service role key di file ini atau di kode frontend.
